# Set these as environment variables on Railway (never commit real values).
# Neon: use the POOLED host for the app role and the DIRECT host for the migrator role.
ConnectionStrings__App=Host=<pooled-host>.neon.tech;Database=cgb_steps;Username=cgb_app;Password=<secret>;SSL Mode=VerifyFull
ConnectionStrings__Migrations=Host=<direct-host>.neon.tech;Database=cgb_steps;Username=cgb_migrator;Password=<secret>;SSL Mode=VerifyFull
Cors__AllowedOrigins__0=https://<admin-site>.vercel.app
ASPNETCORE_ENVIRONMENT=Production
